{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "advisor", "admin"] },
        "registeredAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "name", "role"]
    },
    "PortfolioConfig": {
      "title": "Portfolio Configuration",
      "description": "User portfolio preferences and asset allocation settings",
      "type": "object",
      "properties": {
        "capital": { "type": "number" },
        "strategyName": { "type": "string", "maxLength": 128 },
        "universe": { "type": "string", "maxLength": 128 },
        "topN": { "type": "number" },
        "strategyTemplate": { "type": "string", "maxLength": 128 },
        "allocationSaham": { "type": "number" },
        "allocationEmas": { "type": "number" },
        "allocationCash": { "type": "number" },
        "allocationUSD": { "type": "number" },
        "crashThreshold": { "type": "number" },
        "stopLoss": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["capital", "strategyName"]
    },
    "AlertRule": {
      "title": "Alert Rule",
      "description": "Trigger rule for stock or market alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "maxLength": 64 },
        "condition": { "type": "string", "maxLength": 32 },
        "threshold": { "type": "number" },
        "ticker": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["ON", "OFF"] }
      },
      "required": ["id", "name", "type", "condition", "threshold", "status"]
    },
    "AlertHistory": {
      "title": "Alert History Item",
      "description": "Historical alert notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "time": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["read", "unread"] }
      },
      "required": ["id", "time", "type", "message", "status"]
    },
    "Watchlist": {
      "title": "Watchlist Item",
      "description": "Saved stock ticker in user watchlist",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "symbol"]
    },
    "UserMemory": {
      "title": "User Memory Context",
      "description": "Continuous context updated by AI representing user preferences and discussion history",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "memoryContext": { "type": "string", "maxLength": 8192 },
        "lastUpdated": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "memoryContext", "lastUpdated"]
    },
    "BacktestHistory": {
      "title": "Backtest History Record",
      "description": "Historical backtest simulation run result",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "strategyName": { "type": "string", "maxLength": 128 },
        "universe": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 32 },
        "endDate": { "type": "string", "maxLength": 32 },
        "initialCapital": { "type": "number" },
        "finalEquity": { "type": "number" },
        "cagr": { "type": "number" },
        "maxDrawdown": { "type": "number" },
        "sharpeRatio": { "type": "number" },
        "totalTrades": { "type": "number" }
      },
      "required": ["id", "createdAt", "strategyName", "finalEquity"]
    },
    "ChatSession": {
      "title": "AI Chat Session",
      "description": "User AI chat conversation session and message history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "messages": { "type": "string", "maxLength": 65536 }
      },
      "required": ["id", "title", "updatedAt"]
    },
    "SavedPrompt": {
      "title": "Saved AI Prompt",
      "description": "User saved prompt template for AI advisor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "prompt": { "type": "string", "maxLength": 4096 },
        "category": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "prompt"]
    },
    "Strategy": {
      "title": "User Trading Strategy",
      "description": "User custom trading strategy configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024 },
        "universe": { "type": "string", "maxLength": 128 },
        "rulesJson": { "type": "string", "maxLength": 8192 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User document storing basic profile information"
    },
    "/users/{userId}/configs/portfolio": {
      "schema": { "$ref": "#/entities/PortfolioConfig" },
      "description": "User portfolio configuration settings"
    },
    "/users/{userId}/alertRules/{ruleId}": {
      "schema": { "$ref": "#/entities/AlertRule" },
      "description": "User alert rule entries"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AlertHistory" },
      "description": "User alert notifications history"
    },
    "/users/{userId}/watchlists/{watchlistId}": {
      "schema": { "$ref": "#/entities/Watchlist" },
      "description": "User watchlist items"
    },
    "/users/{userId}/backtests/{backtestId}": {
      "schema": { "$ref": "#/entities/BacktestHistory" },
      "description": "User saved backtest simulation records"
    },
    "/users/{userId}/memory/{memoryId}": {
      "schema": { "$ref": "#/entities/UserMemory" },
      "description": "AI Memory Context for the user"
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User AI chat session records and messages"
    },
    "/users/{userId}/savedPrompts/{promptId}": {
      "schema": { "$ref": "#/entities/SavedPrompt" },
      "description": "User saved prompt templates"
    },
    "/users/{userId}/strategies/{strategyId}": {
      "schema": { "$ref": "#/entities/Strategy" },
      "description": "User custom strategy blueprints"
    }
  }
}
