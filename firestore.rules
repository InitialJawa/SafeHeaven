rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile matching
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Configs subcollection
      match /configs/{configId} {
        allow get: if isOwner(userId) && isValidId(configId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(configId);
      }

      // Alert rules subcollection
      match /alertRules/{ruleId} {
        allow get: if isOwner(userId) && isValidId(ruleId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(ruleId);
      }

      // Alerts history subcollection
      match /alerts/{alertId} {
        allow get: if isOwner(userId) && isValidId(alertId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(alertId);
      }

      // Watchlists subcollection
      match /watchlists/{watchlistId} {
        allow get: if isOwner(userId) && isValidId(watchlistId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(watchlistId);
      }

      // Backtests history subcollection
      match /backtests/{backtestId} {
        allow get: if isOwner(userId) && isValidId(backtestId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(backtestId);
      }

      // Memory subcollection
      match /memory/{memoryId} {
        allow get: if isOwner(userId) && isValidId(memoryId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(memoryId);
      }

      // Chat sessions subcollection
      match /chatSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Saved prompts subcollection
      match /savedPrompts/{promptId} {
        allow get: if isOwner(userId) && isValidId(promptId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(promptId);
      }

      // Custom strategies subcollection
      match /strategies/{strategyId} {
        allow get: if isOwner(userId) && isValidId(strategyId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(strategyId);
      }
    }
  }
}
